{
  "name": "break-room",
  "version": "1.0.0",
  "description": "Multiplayer office rage room: walk around a shared office and smash laptops, monitors and printers together.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "node scripts/stamp-assets.js",
    "test": "node scripts/test.js",
    "check:store": "node scripts/check-store.js",
    "test:redis": "bash scripts/test-with-redis.sh",
    "test:audio": "node test/audio.cjs",
    "test:mobile-chat": "node test/mobile-chat.cjs",
    "test:minimap": "node test/minimap-ui.cjs",
    "test:mobile-safe-area": "node test/mobile-safe-area.cjs",
    "test:office-ui": "node test/office-ui.cjs",
    "test:renderer": "node test/renderer.cjs",
    "test:orientation": "node test/orientation.cjs",
    "test:joystick": "node test/joystick.cjs",
    "test:settings": "node test/settings.cjs",
    "db:migrate": "node scripts/migrate.js",
    "maintenance": "node scripts/maintenance.js",
    "test:identity": "bash scripts/test-identity.sh",
    "test:scores": "bash scripts/test-scores.sh",
    "test:account-ui": "node test/account-ui.cjs",
    "test:install": "node test/install-card.cjs",
    "test:unit": "node scripts/test.js --unit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "ioredis": "^5.11.1",
    "pg": "^8.23.1",
    "ws": "^8.18.0"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": "1.56.1",
    "three": "^0.170.0"
