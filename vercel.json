{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/ws.js": {
      "maxDuration": 300,
      "includeFiles": "{lib/build-info.json,migrations/*.sql}"
    },
    "api/auth/**/*.js": {
      "includeFiles": "migrations/*.sql"
    },
    "api/profile.js": {
      "includeFiles": "migrations/*.sql"
    }
  }
}
