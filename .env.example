# Guest-only local play works with all fields omitted.
# Set these in your shell or use: node --env-file=.env server.js (Node 20.6+).
PORT=3111
AUTH_URL=http://localhost:3111
# Production: AUTH_URL=https://break-room.congtynhu.cc
# Generate a unique random secret of at least 32 characters. Never commit its value.
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Neon pooled runtime URL, TLS verification enabled (sslmode=verify-full recommended).
DATABASE_URL=
# Shared Redis TCP/TLS URL in production, not a REST endpoint.
REDIS_URL=
# Optional migration connection, preferably direct/unpooled, to the SAME database.
# Runtime automatically migrates before the first profile operation.
# Omit this to use DATABASE_URL for migrations too; build never connects to DB.
MIGRATION_DATABASE_URL=

# Daily scoreboard + chat history use DATABASE_URL. Set to 0 to switch a part off.
SCORE_PERSIST=
CHAT_HISTORY=
# Unsynced score events kept in Redis before new ones are refused and counted as dropped (default 20000).
SCORE_QUEUE_MAX=
# Bearer secret (16+ chars, generate randomly, never commit) for GET/POST /api/maintenance.
# The CLI (`npm run maintenance`) does not need it. Vercel Cron sends CRON_SECRET; either name works.
MAINTENANCE_SECRET=
